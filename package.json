{
  "name": "@jessica/root",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Jessica eyewear virtual try-on and frame digitization platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "quality:sample": "npm run build && node apps/quality-harness/cli.mjs fixtures/quality/sample.json",
    "quality:placement": "npm run build && node apps/quality-harness/placement-cli.mjs",
    "quality:evidence": "npm run build && node apps/quality-harness/g1-evidence-cli.mjs",
    "quality:evidence:template-check": "npm run build && node apps/quality-harness/check-evidence-template.mjs",
    "j1m:check": "npm run build && node apps/quality-harness/j1m-readiness-cli.mjs",
    "frame:source:inspect": "node apps/frame-factory/source-inspect-cli.mjs",
    "frame:capture:author": "npm run build && node apps/frame-factory/capture-author-cli.mjs",
    "frame:capture:check": "npm run build && node apps/quality-harness/capture-readiness-cli.mjs",
    "g2:inventory:check": "npm run build && node apps/quality-harness/g2-inventory-cli.mjs",
    "g2:jig:check": "npm run build && node apps/quality-harness/g2-jig-cli.mjs",
    "g2:bakeoff:check": "npm run build && node apps/quality-harness/g2-bakeoff-cli.mjs",
    "dev:try-on": "npm run build && node scripts/serve-static.mjs dist/apps/try-on-web 4173",
    "provision:mediapipe": "node scripts/provision-mediapipe-model.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "typescript": "7.0.2"
  }
}
